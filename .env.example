# Application
APP_ENV=development
LOG_LEVEL=INFO

# CORS — local frontends only. Do NOT use * for shared/production deployments.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL (SQLAlchemy URL with psycopg v3 driver)
# fnip/fnip are LOCAL DOCKER DEMO credentials only — change them for any shared or hosted use
DATABASE_URL=postgresql+psycopg://fnip:fnip@localhost:5433/fnip
# Optional dedicated DB for pytest (created by docker/postgres/init-test-db.sql)
TEST_DATABASE_URL=postgresql+psycopg://fnip:fnip@localhost:5433/fnip_test

# Apify — required for live collection runs (never commit real tokens)
# 1) Create a token at https://console.apify.com/settings/integrations
# 2) Or copy the token from an existing `apify login` session into this value
APIFY_TOKEN=
APIFY_ACTOR_ID=vamsi-krishna/stock-market-news-collector
APIFY_TIMEOUT_SECS=300
APIFY_MAX_RETRIES=3

# Collection input ceilings (validated on POST /collection-runs)
COLLECTION_MAX_ITEMS=500
COLLECTION_MAX_TICKERS=20
COLLECTION_MAX_COMPANIES=20
COLLECTION_MAX_SEARCH_QUERIES=10
COLLECTION_MAX_HOURS_BACK=720

# Collection job worker (Postgres-backed, in-process — no Redis/Celery)
JOB_WORKER_ENABLED=true
JOB_POLL_INTERVAL_SECS=2
JOB_LEASE_SECONDS=900
JOB_MAX_ATTEMPTS=3
JOB_RETRY_DELAY_SECS=30
